{
  "name": "quorum-sql-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --test tests/integration/*.mjs",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "migrate": "node dist/migrate.js",
    "migrate:seed": "node dist/migrate.js --seed",
    "migrate:dev": "tsx src/migrate.ts",
    "smoke": "node dist/smoke.js",
    "smoke:dev": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@sentry/node": "^11.11.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "gaxios": "7.3.1",
    "protobufjs": "8.8.0"
  }
}
